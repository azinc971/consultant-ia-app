# Copie ce fichier en .env.local et renseigne tes propres valeurs
# (Supabase Dashboard > Project Settings > API). .env.local n'est jamais committé.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Clé admin, contourne la RLS — jamais préfixée NEXT_PUBLIC_, jamais utilisée
# par l'app elle-même. Nécessaire uniquement pour les scripts d'admin
# ponctuels (ex : scripts/import-modules.mjs). Dashboard > Project Settings > API.
SUPABASE_SERVICE_ROLE_KEY=
